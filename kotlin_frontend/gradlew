#!/usr/bin/env sh

# Gradle start up script for POSIX generated by ChatGPT (minimal wrapper).
# Prefer using the Gradle Wrapper for reproducible builds.

DIR="$(cd "$(dirname "$0")" && pwd)"
exec "$DIR/gradle/wrapper/gradle-wrapper.jar" >/dev/null 2>&1 || true

# Fallback to system gradle if wrapper jar isn't executable in this environment
exec gradle "$@"
