<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:orientation="vertical"
    android:padding="20dp"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/titleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:text="@string/title_tic_tac_toe"
        android:textColor="@color/app_text"
        android:textSize="24sp" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="sans-serif"
        android:textColor="@color/app_secondary"
        android:textSize="14sp"
        tools:text="X's turn" />

    <LinearLayout
        android:id="@+id/boardCard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="14dp">

        <GridLayout
            android:id="@+id/boardGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alignmentMode="alignMargins"
            android:columnCount="3"
            android:rowCount="3"
            android:useDefaultMargins="true">

            <Button
                android:id="@+id/cell0"
                style="@style/TicTacToeCell"
                android:contentDescription="@string/cell_desc_0" />

            <Button
                android:id="@+id/cell1"
                style="@style/TicTacToeCell"
                android:contentDescription="@string/cell_desc_1" />

            <Button
                android:id="@+id/cell2"
                style="@style/TicTacToeCell"
                android:contentDescription="@string/cell_desc_2" />

            <Button
                android:id="@+id/cell3"
                style="@style/TicTacToeCell"
                android:contentDescription="@string/cell_desc_3" />

            <Button
                android:id="@+id/cell4"
                style="@style/TicTacToeCell"
                android:contentDescription="@string/cell_desc_4" />

            <Button
                android:id="@+id/cell5"
                style="@style/TicTacToeCell"
                android:contentDescription="@string/cell_desc_5" />

            <Button
                android:id="@+id/cell6"
                style="@style/TicTacToeCell"
                android:contentDescription="@string/cell_desc_6" />

            <Button
                android:id="@+id/cell7"
                style="@style/TicTacToeCell"
                android:contentDescription="@string/cell_desc_7" />

            <Button
                android:id="@+id/cell8"
                style="@style/TicTacToeCell"
                android:contentDescription="@string/cell_desc_8" />
        </GridLayout>

        <TextView
            android:id="@+id/hintText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif"
            android:lineSpacingExtra="2dp"
            android:text="@string/hint_text"
            android:textColor="@color/app_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <Button
        android:id="@+id/restartButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_primary_button"
        android:fontFamily="sans-serif-medium"
        android:text="@string/restart"
        android:textAllCaps="false"
        android:textColor="@android:color/white" />

</LinearLayout>
